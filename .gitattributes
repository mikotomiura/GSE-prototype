# Phase 1 dataset-repo-setup: 機械生成 schema の改行正規化を LF に固定。
# Windows runner で git checkout 時に CRLF 変換されると emit_schema の diff が
# 常時 FAIL する (CI drift check が flaky になる) ため、該当ファイルを明示的に
# LF 固定する。
src-tauri/schema/current.json text eol=lf
# ★ P1 事前宣言の凍結 JSON は `include_str!` で埋め込まれ、封筒の `prereg_sha256_prefix` の元になる。
#   CRLF で checkout されると OS ごとに sha が食い違う（code-reviewer M1・2026-09-25）。
src-tauri/prereg/*.json text eol=lf
tests/snapshots/*.json text eol=lf
# ★ 論文キットの単体ロガーは manifest.json を include_bytes! で埋め込み、その SHA-256 を出力のヘッダ（manifest_sha256）に
#   書く。CRLF で checkout されると OS ごとに値が食い違う（IME 論文 判断 32・2026-09-28）。
papers/ime-observation/kit/logger/manifest*.json text eol=lf
tests/fixtures/*.ndjson text eol=lf

# 提出ランチャ: Windows cmd は CRLF 前提。checkout 時に LF 化されると cmd の
# パースが崩れるため CRLF 固定 (UTF-8 BOM は内容なので git が保持する)。
# mac の .command は bash 用なので LF 固定。
*.bat text eol=crlf
*.command text eol=lf
# ★ 論文キットの凍結の印（experiment/preregistration.md の sha256:）は config.json・SEED・正解の規則ファイルの SHA-256 から作る。
#   CRLF で checkout されると機械ごとに値が食い違い、凍結の照合が落ちる（IME 論文 判断 63・2026-09-30）。
papers/ime-observation/experiment/*.json text eol=lf
papers/ime-observation/experiment/SEED text eol=lf
papers/ime-observation/experiment/*.sh text eol=lf
papers/ime-observation/kit/analysis/gt_rules*.json text eol=lf
# ★ 論文キットの計画（plan/1）のヘッダーは手順書とコーパスのファイルの SHA-256（recipes_sha256 / corpus_sha256）を持ち、
#   E2 の閉集合の攻撃は手順書の SHA-256 を計画と照合して違えば止まる。コーパスの SHA-256 は experiment/data.md にも書いてある。
#   CRLF で checkout されると機械ごとに値が食い違う（IME 論文 判断 84・2026-10-01）。
papers/ime-observation/kit/gen/recipes*.json text eol=lf
papers/ime-observation/kit/corpus/data/*.jsonl text eol=lf
