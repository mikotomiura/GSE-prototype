+def text_units(v):
+    """列幅の単位でのおおよその文字幅（全角 ≈ 2、半角 ≈ 1.1）。"""
+    return sum(2.0 if ord(ch) > 0x2E7F else 1.1 for ch in str(v))
+
+
+def row_height(values, widths):
+    """折り返したときの行の高さ（pt）を見積もる。★ openpyxl は行の高さを書かず、Excel は開いたときに自動で広げないため。"""
+    lines = 1
+    for v, w in zip(values, widths):
+        if v is None or v == "":
+            continue
+        text = v["text"] if isinstance(v, dict) else v
+        per_line = max(1.0, w - 1.5)
+        n = sum(max(1, math.ceil(text_units(part) / per_line)) for part in str(text).splitlines() or [""])
+        lines = max(lines, n)
+    return min(409, max(18, 15 * lines + 3))
 
 
