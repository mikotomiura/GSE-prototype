+for f in scripts/secrets-filter.sh scripts/run-codex-review.sh scripts/run-codex-consult.sh; do
+  [ -f "$f" ] || continue
+  [ -x "$f" ] || { echo "FAIL: $f に実行ビットが無い (chmod +x)"; FAIL=1; }
+  MODE=$(git ls-files -s "$f" 2>/dev/null | cut -d' ' -f1)
+  if [ -n "$MODE" ] && [ "$MODE" != "100755" ]; then
+    echo "FAIL: $f の git mode が $MODE (git update-index --chmod=+x $f)"; FAIL=1
